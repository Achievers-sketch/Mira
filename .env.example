# Copy to .env.local for local dev. In production set these in Vercel -> Settings -> Environment Variables.
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL (used for email-confirmation redirects). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEVER prefix secrets with NEXT_PUBLIC_. The service-role key is not used until later phases:
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 (AI chat). SERVER-ONLY SECRETS: never prefix with NEXT_PUBLIC_.
# Choose ONE provider (or set AI_PROVIDER=groq|anthropic when both keys exist).
# Groq (free tier, no card): console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=
# Anthropic (needs prepaid credits):
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. "groq" (free tier, no card) or "anthropic". If unset, uses whichever key is present.
# AI_PROVIDER=groq
# GROQ_API_KEY=            # SECRET. Create at console.groq.com
# GROQ_MODEL=llama-3.3-70b-versatile
